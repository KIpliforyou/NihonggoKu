      "kewajiban",
      "dasar"
    ]
  },
  {
    "id": "bp-005",
    "pattern": "~てもいい",
    "meaning": "Boleh melakukan",
    "function": "Memberikan izin atau persetujuan",
    "formation": "Bentuk -te + mo ii",
    "examples": [
      {
        "japanese": "入ってもいいですか",
        "translation": "Boleh masuk?"
      },
      {
        "japanese": "写真を撮ってもいいですよ",
        "translation": "Boleh mengambil foto kok"
      }
