    "meaning": "Terlalu...",
    "function": "Menyatakan tingkat yang berlebihan",
    "formation": "Adjektiva -sugiru / Adjektiva -ku + sugiru",
    "examples": [
      {
        "japanese": "高すぎる",
        "reading": "たかすぎる",
        "translation": "Terlalu mahal"
      },
