[
  {
    "id": "bp-001",
    "pattern": "~ている",
    "meaning": "Sedang melakukan / sudah mengalami",
    "function": "Menyatakan aksi yang sedang berlangsung atau hasil yang masih bertahan",
    "formation": "Verba -te + iru",
    "examples": [
      {
        "japanese": "本を読んでいる",
        "reading": "ほんをよんでいる",
        "translation": "Saya sedang membaca buku"
      },
      {
        "japanese": "結婚している",
        "reading": "けっこんしている",
        "translation": "Saya sudah menikah"
      }
    ],
    "tags": [
      "verba",
      "lanjutan",
      "dasar"
    ]
  },
  {
    "id": "bp-002",
    "pattern": "~てしまう",
    "meaning": "Sudah selesai / merasa menyesal",
    "function": "Menyatakan sesuatu yang sudah selesai sepenuhnya, atau penyesalan",
    "formation": "Verba -te + shimau",
    "examples": [
      {
        "japanese": "電車を忘れてしまった",
        "translation": "Saya lupa kereta (dan sudah terlalu terlambat)"
      },
      {
        "japanese": "全部食べてしまった",
        "translation": "Saya sudah menghabiskan semuanya"
      }
    ],
    "tags": [
      "verba",
      "penyesalan",
      "penyelesaian"
    ]
  },
  {
    "id": "bp-003",
    "pattern": "~てみる",
    "meaning": "Mencoba melakukan",
    "function": "Mencoba melakukan sesuatu untuk melihat hasilnya",
    "formation": "Verba -te + miru",
    "examples": [
      {
        "japanese": "日本料理食べてみた",
        "translation": "Saya mencoba makan makanan Jepang"
      },
      {
        "japanese": "試してください",
        "reading": "ためしてください",
        "translation": "Silakan coba"
      }
    ],
    "tags": [
      "verba",
      "percobaan",
      "dasar"
    ]
  },
  {
    "id": "bp-004",
