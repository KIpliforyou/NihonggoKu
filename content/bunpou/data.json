  {
    "id": "bp-007",
    "pattern": "~そうだ（様態）",
    "meaning": "Tampak seperti... / terlihat...",
    "function": "Mengungkapkan kesan visual atau dugaan berdasarkan pengamatan",
    "formation": "Adjektiva stem + sou / Verba -soo",
    "examples": [
      {
        "japanese": "美味しいそうですね",
        "translation": "Sepertinya enak ya"
      },
      {
        "japanese": "雨が降りそうです",
        "translation": "Sepertinya akan hujan"
      }
